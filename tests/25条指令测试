# ===== 25条指令完整测试（无标签，数字偏移量，修正版）=====

# ---------- 1. 构造测试数据 ----------
lui  x1, 0x12345          # x1 = 0x12345000
addi x1, x1, 0x678        # x1 = 0x12345678
lui  x2, 0x00FF0          # x2 = 0x00FF0000
addi x2, x2, 0x0FF        # x2 = 0x00FF00FF
addi x3, x0, 1            # x3 = 1
addi x4, x0, 2            # x4 = 2
addi x5, x0, -1           # x5 = 0xFFFFFFFF

# ---------- 2. 算术指令 ----------
add  x6, x1, x2           # x6 = 0x12345678 + 0x00FF00FF = 0x13335777
sub  x7, x1, x2           # x7 = 0x12345678 - 0x00FF00FF = 0x11355579
addi x8, x1, 0x0FF        # x8 = 0x12345678 + 0x0FF = 0x12345777

# ---------- 3. 逻辑指令 ----------
and  x9, x1, x2           # x9 = 0x00340078
or   x10, x1, x2          # x10 = 0x12FF56FF
xor  x11, x1, x2          # x11 = 0x12CB5687
andi x12, x1, 0x0FF       # x12 = 0x00000078
ori  x13, x1, 0x0FF       # x13 = 0x123456FF
xori x14, x1, 0xFFF       # x14 = 0x12345678 ^ 0xFFFFFFFF = 0xEDCBA987  (符号扩展)

# ---------- 4. 移位指令 ----------
slli x15, x3, 2           # x15 = 1 << 2 = 4
srli x16, x5, 1           # x16 = 0x7FFFFFFF (逻辑右移)
sll  x17, x3, x4          # x17 = 1 << 2 = 4
srl  x18, x5, x4          # x18 = 0x3FFFFFFF

# ---------- 5. 比较指令 ----------
slti x19, x3, 2           # x19 = 1 (1 < 2)
sltiu x20, x3, 2          # x20 = 1

# ---------- 6. 高位立即数 ----------
lui  x21, 0x80000         # x21 = 0x80000000

# ---------- 7. 访存指令 ----------
lui  x30, 0x12345
addi x30, x30, 0x678      # x30 = 0x12345678
sw   x30, 0(x0)           # 内存[0] = 0x12345678
sh   x30, 4(x0)           # 内存[4] = 0x5678 (低16位)
sb   x30, 8(x0)           # 内存[8] = 0x78   (最低字节)
lb   x31, 8(x0)           # x31 = 0x00000078 (有符号字节)
lh   x30, 4(x0)           # x30 = 0x00005678 (有符号半字)
lw   x29, 0(x0)           # x29 = 0x12345678

# ---------- 8. 分支测试（beq）----------
addi x22, x0, 5
addi x23, x0, 5
beq  x22, x23, 8          # 条件成立，跳转12字节（跳过2条）
addi x24, x0, 0           # 不执行
addi x24, x0, 0           # 不执行
addi x24, x0, 1           # 目标，x24=1

# ---------- 9. 分支测试（bne）----------
addi x25, x0, 3
addi x26, x0, 5
bne  x25, x26, 8          # 条件成立，跳转12字节（跳过2条）
addi x27, x0, 0           # 不执行
addi x27, x0, 0           # 不执行
addi x27, x0, 1           # 目标，x27=1

# ---------- 10. 跳转并链接（jal）----------
jal  x28, 12              # 跳转到12字节后，x28=返回地址(PC+4)
addi x29, x0, 0           # 不执行（被跳过）
addi x29, x0, 0           # 不执行
addi x29, x0, 0           # 不执行
addi x29, x0, 1           # 目标，x29=1

# ---------- 11. 结束（死循环）----------
jal  x0, 0                # 跳转到自身，停在这里
